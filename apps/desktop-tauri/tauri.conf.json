{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rakazo",
  "version": "0.3.3",
  "identifier": "dev.rakazo.desktop",
  "build": {
    "beforeDevCommand": "pnpm --filter @rakazo/web dev --host 127.0.0.1",
    "beforeBuildCommand": "pnpm --filter @rakazo/web build",
    "devUrl": "http://127.0.0.1:5173",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Rakazo",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["rakazo"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis", "appimage"],
    "category": "Productivity",
    "shortDescription": "Persistent AI teammates",
    "longDescription": "Rakazo is an open-source platform for persistent AI teammates and desktop automation.",
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "webviewInstallMode": "embedBootstrapper"
    }
  }
}
