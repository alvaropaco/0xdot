{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "0xdot",
  "version": "0.3.3",
  "identifier": "com.0xdot.desktop",
  "build": {
    "beforeDevCommand": "pnpm --filter @rakazo/web dev --host 127.0.0.1",
    "beforeBuildCommand": "pnpm --filter @rakazo/web build",
    "devUrl": "http://127.0.0.1:5173",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "0xdot",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["xdot"]
      }
    },
    "updater": {
      "pubkey": "",
      "endpoints": []
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis", "appimage"],
    "category": "Productivity",
    "shortDescription": "Persistent AI teammates",
    "longDescription": "0xdot is an open-source platform for persistent AI teammates and desktop automation.",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    },
    "windows": {
      "webviewInstallMode": { "type": "embedBootstrapper" }
    }
  }
}
